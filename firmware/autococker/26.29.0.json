{
  "schema_version": "2.0.0",
  "firmware": {
    "name": [
      {
        "lang": "en",
        "text": "SnapshotPB Autococker firmware"
      }
    ],
    "version": "26.29.0",
    "protocol_version": "1.0.0",
    "board_models": [
      "BOARD_MODEL_AUTOCOCKER"
    ],
    "summary": [
      {
        "lang": "en",
        "text": "The firmware of the SnapshotPB Autococker board. It drives the sear solenoid and the cocking solenoid of an autococker marker, reads the trigger and the ball eye, and shows a menu on the screen of the board."
      }
    ]
  },
  "media": {
    "buttons_back": {
      "kind": "image",
      "src": "pcb:docs/images/quick-start/buttons-back.svg",
      "caption": [
        {
          "lang": "en",
          "text": "The three buttons at the back of the grip frame: UP, MENU, and DOWN."
        }
      ]
    }
  },
  "controls": {
    "enter": {
      "name": [
        {
          "lang": "en",
          "text": "MENU"
        }
      ],
      "description": [
        {
          "lang": "en",
          "text": "The centre button of the three at the back of the grip frame. It opens the menu, selects a row, and commits a value."
        }
      ],
      "events": {
        "short": {
          "description": [
            {
              "lang": "en",
              "text": "A press and a release in less than the hold time."
            }
          ]
        },
        "long": {
          "description": [
            {
              "lang": "en",
              "text": "A push that lasts the hold time or longer."
            }
          ],
          "hold_ms": 600
        }
      },
      "media": [
        "buttons_back"
      ]
    },
    "up": {
      "name": [
        {
          "lang": "en",
          "text": "UP"
        }
      ],
      "description": [
        {
          "lang": "en",
          "text": "The top button of the three. It moves the cursor up and increases a value."
        }
      ],
      "events": {
        "short": {
          "description": [
            {
              "lang": "en",
              "text": "A press and a release in less than the hold time."
            }
          ]
        },
        "long": {
          "description": [
            {
              "lang": "en",
              "text": "A push that lasts the hold time or longer."
            }
          ],
          "hold_ms": 600
        }
      }
    },
    "down": {
      "name": [
        {
          "lang": "en",
          "text": "DOWN"
        }
      ],
      "description": [
        {
          "lang": "en",
          "text": "The bottom button of the three. It moves the cursor down and decreases a value."
        }
      ],
      "events": {
        "short": {
          "description": [
            {
              "lang": "en",
              "text": "A press."
            }
          ]
        }
      }
    },
    "lockout": {
      "name": [
        {
          "lang": "en",
          "text": "LOCKOUT"
        }
      ],
      "description": [
        {
          "lang": "en",
          "text": "The button on the board. It locks and unlocks the settings."
        }
      ],
      "events": {
        "short": {
          "description": [
            {
              "lang": "en",
              "text": "A press."
            }
          ]
        }
      }
    }
  },
  "interactions": {
    "open_menu": {
      "control": "enter",
      "event": "short",
      "description": [
        {
          "lang": "en",
          "text": "Opens the Menu screen from the home screen."
        }
      ],
      "applies_to": [
        "home"
      ]
    },
    "cursor_up": {
      "control": "up",
      "event": "short",
      "description": [
        {
          "lang": "en",
          "text": "Moves the cursor one row up. On the first row, the cursor stays."
        }
      ],
      "applies_to": [
        "screen"
      ]
    },
    "cursor_down": {
      "control": "down",
      "event": "short",
      "description": [
        {
          "lang": "en",
          "text": "Moves the cursor one row down. On the last row, the cursor stays."
        }
      ],
      "applies_to": [
        "screen"
      ]
    },
    "select": {
      "control": "enter",
      "event": "short",
      "description": [
        {
          "lang": "en",
          "text": "Acts on the row under the cursor. A screen row opens its screen. A number row opens the number editor. A choice row opens the choice editor. A switch row changes its value at once. A row that does not apply does nothing."
        }
      ],
      "applies_to": [
        "screen"
      ]
    },
    "back": {
      "control": "enter",
      "event": "short",
      "description": [
        {
          "lang": "en",
          "text": "On the Back row, returns to the parent screen. On the Back row of the Menu screen, returns to the home screen."
        }
      ],
      "applies_to": [
        "screen"
      ]
    },
    "value_up": {
      "control": "up",
      "event": "short",
      "description": [
        {
          "lang": "en",
          "text": "In the number editor, increases the value by one step. In the choice editor, moves to the next option. The value stops at the maximum."
        }
      ],
      "applies_to": [
        "edit_int",
        "edit_enum"
      ]
    },
    "value_down": {
      "control": "down",
      "event": "short",
      "description": [
        {
          "lang": "en",
          "text": "In the number editor, decreases the value by one step. In the choice editor, moves to the previous option. The value stops at the minimum."
        }
      ],
      "applies_to": [
        "edit_int",
        "edit_enum"
      ]
    },
    "commit": {
      "control": "enter",
      "event": "short",
      "description": [
        {
          "lang": "en",
          "text": "In an editor, keeps the value and returns to the screen. An editor has no cancel. A value that did not change is not written."
        }
      ],
      "applies_to": [
        "edit_int",
        "edit_enum"
      ]
    },
    "power_off": {
      "control": "enter",
      "event": "long",
      "description": [
        {
          "lang": "en",
          "text": "Turns the board off from each screen that takes input. The screen shows Powering Off, and then it goes dark."
        }
      ]
    },
    "wake": {
      "control": "enter",
      "event": "long",
      "description": [
        {
          "lang": "en",
          "text": "Turns the board on. A short press wakes the board, and the board goes back to sleep if you release MENU before the hold time."
        }
      ]
    },
    "eye_override": {
      "control": "up",
      "event": "long",
      "description": [
        {
          "lang": "en",
          "text": "Turns the eyes off or on for this session. The screen shows EYES OFF or EYES ON. The stored eye mode does not change."
        }
      ],
      "applies_to": [
        "home"
      ]
    },
    "lockout_toggle": {
      "control": "lockout",
      "event": "short",
      "description": [
        {
          "lang": "en",
          "text": "Locks or unlocks the settings. The screen shows LOCKED or UNLOCKED."
        }
      ]
    }
  },
  "home": {
    "title": [
      {
        "lang": "en",
        "text": "Shot counter"
      }
    ],
    "description": [
      {
        "lang": "en",
        "text": "The screen that the board shows after the boot text. It shows the shot count and the state marks. Press MENU on this screen to open the menu. The screen goes dark after the Screen off time, and the first press after that wakes the screen and does nothing else."
      }
    ],
    "indicators": {
      "lock": [
        {
          "lang": "en",
          "text": "The LOCK tag shows while the board is locked."
        }
      ],
      "bluetooth": [
        {
          "lang": "en",
          "text": "The Bluetooth mark shows while the Bluetooth radio is on."
        }
      ],
      "eyes": [
        {
          "lang": "en",
          "text": "The eye mark shows the eye state: on, off, or off for this session."
        }
      ]
    }
  },
  "root": "root",
  "screens": {
    "root": {
      "title": [
        {
          "lang": "en",
          "text": "Menu"
        }
      ],
      "description": [
        {
          "lang": "en",
          "text": "The first screen of the menu. The Profile row and the Language row select how the whole board works. The screen rows below them hold the settings of one subject each. The Bluetooth row turns the radio on or off."
        }
      ],
      "items": [
        {
          "type": "setting",
          "render": [
            {
              "lang": "en",
              "text": "Profile"
            }
          ],
          "key": "device_config.active_profile"
        },
        {
          "type": "setting",
          "render": [
            {
              "lang": "en",
              "text": "Language"
            }
          ],
          "key": "device_config.language"
        },
        {
          "type": "submenu",
          "render": [
            {
              "lang": "en",
              "text": "Fire"
            }
          ],
          "ref": "fire_menu"
        },
        {
          "type": "submenu",
          "render": [
            {
              "lang": "en",
              "text": "Timing"
            }
          ],
          "ref": "timing_menu"
        },
        {
          "type": "submenu",
          "render": [
            {
              "lang": "en",
              "text": "Trigger"
            }
          ],
          "ref": "trigger_menu"
        },
        {
          "type": "submenu",
          "render": [
            {
              "lang": "en",
              "text": "Eye"
            }
          ],
          "ref": "eye_menu"
        },
        {
          "type": "submenu",
          "render": [
            {
              "lang": "en",
              "text": "Setup"
            }
          ],
          "ref": "setup_menu"
        },
        {
          "type": "setting",
          "render": [
            {
              "lang": "en",
              "text": "Bluetooth"
            }
          ],
          "key": "runtime.bluetooth_active"
        },
        {
          "type": "back",
          "render": [
            {
              "lang": "en",
              "text": "Back"
            }
          ]
        }
      ]
    },
    "fire_menu": {
      "title": [
        {
          "lang": "en",
          "text": "Fire"
        }
      ],
      "description": [
        {
          "lang": "en",
          "text": "The fire mode and the rate of fire of the active profile. The Ramping row shows only while the fire mode is NXL 2026."
        }
      ],
      "items": [
        {
          "type": "setting",
          "render": [
            {
              "lang": "en",
              "text": "Mode"
            }
          ],
          "key": "autococker.fire_mode"
        },
        {
          "type": "setting",
          "render": [
            {
              "lang": "en",
              "text": "BPS cap"
            }
          ],
          "key": "profile.fire_rate_cap"
        },
        {
          "type": "submenu",
          "render": [
            {
              "lang": "en",
              "text": "Ramping"
            }
          ],
          "ref": "ramp_menu",
          "hidden_when": "ramping_off"
        },
        {
          "type": "back",
          "render": [
            {
              "lang": "en",
              "text": "Back"
            }
          ]
        }
      ]
    },
    "timing_menu": {
      "title": [
        {
          "lang": "en",
          "text": "Timing"
        }
      ],
      "description": [
        {
          "lang": "en",
          "text": "The times of one firing cycle, in milliseconds with one decimal place."
        }
      ],
      "items": [
        {
          "type": "setting",
          "render": [
            {
              "lang": "en",
              "text": "Sear dwell"
            }
          ],
          "key": "autococker.sear_solenoid_dwell"
        },
        {
          "type": "setting",
          "render": [
            {
              "lang": "en",
              "text": "Cock delay"
            }
          ],
          "key": "autococker.cocking_solenoid_delay"
        },
        {
          "type": "setting",
          "render": [
            {
              "lang": "en",
              "text": "Cock open"
            }
          ],
          "key": "autococker.cocking_solenoid_dwell_open"
        },
        {
          "type": "setting",
          "render": [
            {
              "lang": "en",
              "text": "Cock close"
            }
          ],
          "key": "autococker.cocking_solenoid_dwell_closed"
        },
        {
          "type": "setting",
          "render": [
            {
              "lang": "en",
              "text": "Cock timeout"
            }
          ],
          "key": "autococker.cocking_solenoid_timeout",
          "disabled_when": "eye_inactive"
        },
        {
          "type": "back",
          "render": [
            {
              "lang": "en",
              "text": "Back"
            }
          ]
        }
      ]
    },
    "trigger_menu": {
      "title": [
        {
          "lang": "en",
          "text": "Trigger"
        }
      ],
      "description": [
        {
          "lang": "en",
          "text": "The debounce times of the trigger."
        }
      ],
      "items": [
        {
          "type": "setting",
          "render": [
            {
              "lang": "en",
              "text": "Debounce on"
            }
          ],
          "key": "autococker.trigger_debounce_on"
        },
        {
          "type": "setting",
          "render": [
            {
              "lang": "en",
              "text": "Debounce off"
            }
          ],
          "key": "autococker.trigger_debounce_off"
        },
        {
          "type": "back",
          "render": [
            {
              "lang": "en",
              "text": "Back"
            }
          ]
        }
      ]
    },
    "eye_menu": {
      "title": [
        {
          "lang": "en",
          "text": "Eye"
        }
      ],
      "description": [
        {
          "lang": "en",
          "text": "The ball eye of the active profile. The rows apply only in a fire mode with an eye phase."
        }
      ],
      "items": [
        {
          "type": "setting",
          "render": [
            {
              "lang": "en",
              "text": "Eye mode"
            }
          ],
          "key": "autococker.eye_mode",
          "disabled_when": "no_eye_phase"
        },
        {
          "type": "setting",
          "render": [
            {
              "lang": "en",
              "text": "Threshold"
            }
          ],
          "key": "autococker.eye_threshold",
          "disabled_when": "eye_inactive"
        },
        {
          "type": "setting",
          "render": [
            {
              "lang": "en",
              "text": "Debounce"
            }
          ],
          "key": "autococker.eye_debounce",
          "disabled_when": "eye_inactive"
        },
        {
          "type": "back",
          "render": [
            {
              "lang": "en",
              "text": "Back"
            }
          ]
        }
      ]
    },
    "ramp_menu": {
      "title": [
        {
          "lang": "en",
          "text": "Ramping"
        }
      ],
      "description": [
        {
          "lang": "en",
          "text": "The custom ramp settings. The rows apply only while the fire mode is NXL 2026."
        }
      ],
      "items": [
        {
          "type": "setting",
          "render": [
            {
              "lang": "en",
              "text": "Multiplier"
            }
          ],
          "key": "autococker.ramping_custom_multiplier",
          "disabled_when": "ramping_off"
        },
        {
          "type": "setting",
          "render": [
            {
              "lang": "en",
              "text": "Trigger pulls"
            }
          ],
          "key": "autococker.ramping_custom_trigger_pulls",
          "disabled_when": "ramping_off"
        },
        {
          "type": "setting",
          "render": [
            {
              "lang": "en",
              "text": "RoF minimum"
            }
          ],
          "key": "autococker.ramping_custom_rof_minimum",
          "disabled_when": "ramping_off"
        },
        {
          "type": "back",
          "render": [
            {
              "lang": "en",
              "text": "Back"
            }
          ]
        }
      ]
    },
    "setup_menu": {
      "title": [
        {
          "lang": "en",
          "text": "Setup"
        }
      ],
      "description": [
        {
          "lang": "en",
          "text": "The board settings: the power, the screen, and the battery."
        }
      ],
      "items": [
        {
          "type": "setting",
          "render": [
            {
              "lang": "en",
              "text": "Auto off"
            }
          ],
          "key": "profile.board_auto_off"
        },
        {
          "type": "setting",
          "render": [
            {
              "lang": "en",
              "text": "Screen off"
            }
          ],
          "key": "device_config.screen_off_delay"
        },
        {
          "type": "setting",
          "render": [
            {
              "lang": "en",
              "text": "Brightness"
            }
          ],
          "key": "device_config.screen_brightness"
        },
        {
          "type": "setting",
          "render": [
            {
              "lang": "en",
              "text": "Full window"
            }
          ],
          "key": "runtime.display_window_full"
        },
        {
          "type": "setting",
          "render": [
            {
              "lang": "en",
              "text": "Battery"
            }
          ],
          "key": "device_config.battery_type"
        },
        {
          "type": "back",
          "render": [
            {
              "lang": "en",
              "text": "Back"
            }
          ]
        }
      ]
    }
  },
  "settings": {
    "device_config.active_profile": {
      "title": [
        {
          "lang": "en",
          "text": "Profile"
        }
      ],
      "description": [
        {
          "lang": "en",
          "text": "The profile that the board uses. The board holds four profiles. Each profile holds its own fire, timing, trigger, eye, and ramping settings."
        }
      ],
      "scope": "device",
      "type": "enum",
      "options": [
        {
          "value": 1,
          "text": [
            {
              "lang": "en",
              "text": "1"
            }
          ],
          "description": [
            {
              "lang": "en",
              "text": "Profile 1."
            }
          ]
        },
        {
          "value": 2,
          "text": [
            {
              "lang": "en",
              "text": "2"
            }
          ],
          "description": [
            {
              "lang": "en",
              "text": "Profile 2."
            }
          ]
        },
        {
          "value": 3,
          "text": [
            {
              "lang": "en",
              "text": "3"
            }
          ],
          "description": [
            {
              "lang": "en",
              "text": "Profile 3."
            }
          ]
        },
        {
          "value": 4,
          "text": [
            {
              "lang": "en",
              "text": "4"
            }
          ],
          "description": [
            {
              "lang": "en",
              "text": "Profile 4."
            }
          ]
        }
      ],
      "default": 1
    },
    "device_config.language": {
      "title": [
        {
          "lang": "en",
          "text": "Language"
        }
      ],
      "description": [
        {
          "lang": "en",
          "text": "The language of the text that the board draws: the row names, the titles, the options, and the captions. It does not change the boot text or a profile name, which hold the text that you typed."
        }
      ],
      "scope": "device",
      "type": "enum",
      "options": [
        {
          "value": "LANGUAGE_EN",
          "text": [
            {
              "lang": "en",
              "text": "EN"
            }
          ],
          "description": [
            {
              "lang": "en",
              "text": "English."
            }
          ]
        },
        {
          "value": "LANGUAGE_ES",
          "text": [
            {
              "lang": "en",
              "text": "ES"
            }
          ],
          "description": [
            {
              "lang": "en",
              "text": "Spanish."
            }
          ]
        },
        {
          "value": "LANGUAGE_DE",
          "text": [
            {
              "lang": "en",
              "text": "DE"
            }
          ],
          "description": [
            {
              "lang": "en",
              "text": "German."
            }
          ]
        },
        {
          "value": "LANGUAGE_FR",
          "text": [
            {
              "lang": "en",
              "text": "FR"
            }
          ],
          "description": [
            {
              "lang": "en",
              "text": "French."
            }
          ]
        }
      ],
      "default": "LANGUAGE_EN"
    },
    "runtime.bluetooth_active": {
      "title": [
        {
          "lang": "en",
          "text": "Bluetooth"
        }
      ],
      "description": [
        {
          "lang": "en",
          "text": "Turns the Bluetooth radio on or off. The radio is off at each start. The screen shows BT ON or BT OFF, and the status LED is blue while the radio is on. The app connects only while the radio is on."
        }
      ],
      "scope": "runtime",
      "type": "toggle",
      "default": false,
      "on_text": [
        {
          "lang": "en",
          "text": "On"
        }
      ],
      "off_text": [
        {
          "lang": "en",
          "text": "Off"
        }
      ],
      "related": [
        "topic.bluetooth"
      ]
    },
    "autococker.fire_mode": {
      "title": [
        {
          "lang": "en",
          "text": "Fire mode"
        }
      ],
      "description": [
        {
          "lang": "en",
          "text": "How the board answers a trigger pull. The board fires at the slower of the cycle time and the BPS cap in each mode that fires by itself."
        }
      ],
      "scope": "profile",
      "type": "enum",
      "options": [
        {
          "value": "AUTOCOCKER_FIRE_MODE_MECHANICAL",
          "text": [
            {
              "lang": "en",
              "text": "MECHANICAL"
            }
          ],
          "description": [
            {
              "lang": "en",
              "text": "The board works as a mechanical autococker. A trigger pull energizes the sear for the Sear dwell time. The cocking solenoid is on while the trigger is pulled, and off while the trigger is released. The eye does not apply."
            }
          ]
        },
        {
          "value": "AUTOCOCKER_FIRE_MODE_SEMI",
          "text": [
            {
              "lang": "en",
              "text": "SEMI"
            }
          ],
          "description": [
            {
              "lang": "en",
              "text": "One shot for each trigger pull, as fast as you pull the trigger."
            }
          ]
        },
        {
          "value": "AUTOCOCKER_FIRE_MODE_TRIGGER_ONLY",
          "text": [
            {
              "lang": "en",
              "text": "TRIGGER ONLY"
            }
          ],
          "description": [
            {
              "lang": "en",
              "text": "For a pump marker. The board never energizes the cocking solenoid, so the eye does not apply. The sear and the trigger times apply."
            }
          ]
        },
        {
          "value": "AUTOCOCKER_FIRE_MODE_FULL_AUTO",
          "text": [
            {
              "lang": "en",
              "text": "FULL AUTO"
            }
          ],
          "description": [
            {
              "lang": "en",
              "text": "The board fires while the trigger is pulled."
            }
          ]
        },
