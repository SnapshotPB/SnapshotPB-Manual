{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/worktree-guard.sh",
            "timeout": 10,
            "onFailure": "block",
            "statusMessage": "Worktree guard"
          }
        ]
      }
    ]
  },
  "worktree": {
    "baseRef": "fresh"
  }
}
