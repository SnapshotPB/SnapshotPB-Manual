  "topics": {
    "topic.power_off": {
      "title": [
        {
          "lang": "en",
          "text": "Turn the board off and on"
        }
      ],
      "description": [
        {
          "lang": "en",
          "text": "Hold MENU. The screen shows Powering Off, and then the screen goes dark. To start the board again, hold MENU. A short press wakes the board, and the board goes back to sleep if you release MENU before the hold time.\n\nThe Auto off setting turns the board off by itself after a time with no trigger pull and no button press."
        }
      ],
      "interactions": [
        "power_off",
        "wake"
      ],
      "related": [
        "profile.board_auto_off"
      ]
    },
    "topic.lockout": {
      "title": [
        {
          "lang": "en",
          "text": "Lockout"
        }
      ],
      "description": [
        {
          "lang": "en",
          "text": "Lockout is a lock on the settings. It is not a lock on the firing. A locked board fires as a board that is not locked.\n\nPress LOCKOUT to lock the board. The screen shows LOCKED, and the home screen shows the LOCK tag. A locked board does not keep a change from the menu, and it does not keep a change from the app. Press LOCKOUT again to unlock the board. The screen shows UNLOCKED.\n\nThe board keeps the lock through a power cycle. A locked board starts on the locked screen, which shows the shot counter only."
        }
      ],
      "interactions": [
        "lockout_toggle"
      ]
    },
    "topic.eye_override": {
      "title": [
        {
          "lang": "en",
          "text": "Eye override"
        }
      ],
      "description": [
        {
          "lang": "en",
          "text": "Hold UP on the home screen to turn the eyes off for this session, for example after an eye fails in a game. The screen shows EYES OFF. Hold UP again to turn them on. The screen shows EYES ON. The stored Eye mode does not change, and the next start uses the stored Eye mode.\n\nThe screen shows NO EYE when the Eye mode is OFF, or when the fire mode has no eye phase."
        }
      ],
      "interactions": [
        "eye_override"
      ],
      "related": [
        "autococker.eye_mode"
      ]
    },
    "topic.bluetooth": {
      "title": [
        {
          "lang": "en",
          "text": "Bluetooth"
        }
      ],
      "description": [
        {
          "lang": "en",
          "text": "The Bluetooth radio is off at each start. Press MENU on the Bluetooth row of the Menu screen to turn the radio on. The screen shows BT ON, and the status LED goes blue. The board shows the name Snapshot PB to a phone. The screen shows BT FAIL when the radio does not start."
        }
      ],
      "related": [
        "runtime.bluetooth_active"
      ]
    },
    "topic.firing_cycle": {
      "title": [
        {
          "lang": "en",
          "text": "The firing cycle"
        }
      ],
      "description": [
        {
          "lang": "en",
          "text": "The Timing screen sets the times of one firing cycle. All times are in milliseconds.\n\n1. You pull the trigger. The trigger must stay pulled for the Debounce on time.\n\n2. The board energizes the sear solenoid for the Sear dwell time. The marker fires.\n\n3. The board waits for the Cock delay time.\n\n4. The board energizes the cocking solenoid, which opens the breech. With no eye, the solenoid stays energized for the Cock open time. With an eye, the solenoid stays energized until the eye sees a ball, or until the Cock timeout time ends.\n\n5. The board releases the cocking solenoid, and it waits for the Cock close time before the next cycle.\n\nThe BPS cap limits the rate of fire. The board fires at the slower of the cycle time and the BPS cap."
        }
      ],
      "related": [
        "autococker.sear_solenoid_dwell",
        "autococker.cocking_solenoid_delay",
        "autococker.cocking_solenoid_dwell_open",
        "autococker.cocking_solenoid_dwell_closed",
        "autococker.cocking_solenoid_timeout",
        "profile.fire_rate_cap"
      ]
    },
    "topic.ramping": {
      "title": [
        {
          "lang": "en",
          "text": "Ramping"
        }
      ],
      "description": [
        {
          "lang": "en",
          "text": "The NXL 2026 fire mode applies the rules of the NXL 2026 season. The board fires at a maximum of 10.5 balls per second. The board enters the ramp after 3 trigger pulls at an interval of 200 ms or less.\n\nThe Ramping screen holds the custom ramp settings. The Fire screen shows the Ramping row only while the fire mode is NXL 2026."
        }
      ],
      "related": [
        "autococker.fire_mode",
        "autococker.ramping_custom_multiplier",
        "autococker.ramping_custom_trigger_pulls",
        "autococker.ramping_custom_rof_minimum"
      ]
    },
    "topic.captions": {
      "title": [
        {
          "lang": "en",
          "text": "The captions"
        }
      ],
      "description": [
        {
          "lang": "en",
          "text": "The screen shows a caption for a moment after some actions.\n\nLOCKED and UNLOCKED: the lock changed. LOCK on the home screen: the board is locked.\n\nEYES ON and EYES OFF: the eye override changed. NO EYE: the eye does not apply.\n\nBT ON and BT OFF: the radio changed. BT FAIL: the radio did not start.\n\nSAVE FAIL: the board could not store a setting.\n\nPowering Off: the board turns off."
        }
      ],
      "related": [
        "topic.lockout",
        "topic.eye_override",
        "topic.bluetooth"
      ]
    }
  }
}
